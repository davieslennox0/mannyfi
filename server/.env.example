# MannyFi server. Copy to .env (gitignored) and fill in. No real values here.

SARF_ENV=production              # production fails closed: no valid session = 401
SARF_SESSION_SECRET=             # >= 32 chars, e.g. `openssl rand -hex 32`
SARF_DB_PATH=./data/basket.db
SARF_PORT=8760
SARF_ALLOWED_HOSTS=mannyfi.xyz,mcp.mannyfi.xyz   # public hostnames (website and MCP connector)
SARF_PUBLIC_URL=https://mannyfi.xyz      # OAuth issuer (the website host proxies /authorize and /api to the server)
SARF_WEB_URL=https://mannyfi.xyz         # the dashboard: sign links and the OAuth consent page
SARF_MCP_PUBLIC_URL=https://mcp.mannyfi.xyz   # the connector address is this + /mcp
WEB_ORIGINS=https://mannyfi.xyz          # browser origins allowed to call /api (add http://localhost:3000 for dev)

# NEAR
NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_LOGIN_RECIPIENT=mannyfi

# NEAR Intents (1Click)
INTENTS_API_URL=https://1click.chaindefuser.com
INTENTS_API_KEY=                 # partner key: REQUIRED for buy_basket / sell_basket
INTENTS_JWT=                     # optional, lowers quote fees
INTENTS_SLIPPAGE_BPS=100

# Hard ceilings (enforced in code, not by the model)
MAX_BASKET_USD=50                # per-order ceiling while the product is young (we recommend buying from $50)
MAX_DAILY_USD=100                # ceiling a user may pick for their daily limit
API_PER_MINUTE=120               # website API requests per IP per minute
API_STRICT_PER_MINUTE=30         # sign-in, registration and money routes
MAX_ORDERS_PER_HOUR=30           # orders one account may build per hour
OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com   # who may receive an OAuth code

# One signature per order. A gas-only NEAR account relays the batch the user signed.
# Fund it with about 0.5 NEAR; orders fall back to one approval per swap while it is empty.
RELAYER_KEY_FILE=/path/to/relayer.json   # {"account_id","public_key","secret_key"}; never commit
RELAYER_GAS_TGAS=100
RELAYER_MIN_NEAR=0.15
MAX_LEG_COST_PCT=5.0
ORDER_TTL_SECONDS=600
